#!/bin/sh
# 커밋 전에 규칙을 확인하고 (Tools/hooks/check_commit.py),
# 게임 파일이 바뀐 커밋이면 문서를 다시 만들어 함께 넣어요 (Tools/docs/update_docs.py)
# 켜기 (클론마다 한 번) : git config core.hooksPath .githooks
export PYTHONIOENCODING=utf-8

# 문서 그림에 Pillow 가 필요해요. Pillow 가 있는 Python 을 골라요 (msys64 의 python 에는 없어요)
PY=""
for cand in "py -3" python python3; do
    if $cand -c "import PIL" >/dev/null 2>&1; then PY="$cand"; break; fi
done
if [ -z "$PY" ]; then
    echo "[검사] Pillow 가 있는 Python 을 못 찾았어요. 'py -3 -m pip install pillow' 로 설치해 주세요."
    exit 1
fi

$PY Tools/hooks/check_commit.py || exit 1
exec $PY Tools/docs/update_docs.py --pre-commit
