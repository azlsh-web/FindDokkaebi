    wrongSprite: {fileID: 21300000, guid: 02539ee023b693b47b12269f4e1fd590, type: 3}
  - id: F5
    name: "\uC591 \uB05D \uB760 \uD30C\uB791"
    criteria: "\uAC00\uC7A5 \uC67C\uCABD \uB760\uC640 \uAC00\uC7A5 \uC624\uB978\uCABD
      \uB760\uC758 \uC8FC\uB41C \uCC44\uC0C9\uC774 \uBAA8\uB450 \uD30C\uB780\uC0C9
      \uACC4\uC5F4\uC774\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uD55C\uCABD\uB9CC \uD30C\uB791\uC774\uBA74
      \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
