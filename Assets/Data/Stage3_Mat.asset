  m_Script: {fileID: 11500000, guid: 76559bebd3ca412438493db7848d8f3b, type: 3}
  m_Name: Stage3_Mat
  m_EditorClassIdentifier: Assembly-CSharp::StageData
  stageNumber: 3
  targetName: "\uB3D7\uC790\uB9AC"
  introStory: "\uB2E4\uC74C\uC740 \uC18C\uD48D\uC5D0 \uAE54\uACE0 \uC549\uC744 \uB3D7\uC790\uB9AC\uC608\uC694.\n\uC774\uBC88\uC5D0\uB294
    \uC0C9\uB3C4 \uAE30\uC5B5\uD574\uC57C \uD574\uC694!\n\uC5B4\uB290 \uCE78\uC774
    \uBB34\uC2A8 \uC0C9\uC774\uC5C8\uB294\uC9C0 \uC798 \uBCF4\uC138\uC694."
  newRule: "\uBE68\uAC15 \xB7 \uB178\uB791 \xB7 \uD30C\uB791 \uBC84\uD2BC\uC73C\uB85C
    \uC0C9\uC744 \uACE8\uB77C \uCE60\uD574\uC694.\n\uC0C9\uC774 \uB4E4\uC5B4\uAC04
    \uC704\uCE58\uB3C4 \uAE30\uC5B5\uD574\uC57C \uD574\uC694."
  learnedRules: "\uBAA8\uC591 \uADF8\uB9AC\uAE30 \xB7 \uBB34\uB2AC \uB123\uAE30"
  colorMode: 1
  originalSprite: {fileID: 21300000, guid: 4d614857685b6f44eb340629db6b4db9, type: 3}
  targetDescription: "\uC815\uBA74\uC5D0\uC11C \uBCF8 \uC9C1\uC0AC\uAC01\uD615 \uB3D7\uC790\uB9AC\uC785\uB2C8\uB2E4.
    \uB0B4\uBD80\uB294 \uAC80\uC740\uC0C9 \uAC00\uB85C\uC120 \uD558\uB098\uC640 \uC138\uB85C\uC120
    \uD558\uB098\uB85C \uC704\uC544\uB798 \uB450 \uC904, \uC88C\uC6B0 \uB450 \uCE78\uC758
    \uB124 \uC601\uC5ED\uC73C\uB85C \uB098\uB269\uB2C8\uB2E4. \uD654\uBA74\uC5D0\uC11C
    \uBCF4\uC774\uB294 \uBC29\uD5A5\uC744 \uAE30\uC900\uC73C\uB85C \uC67C\uCABD \uC704
    \uC601\uC5ED\uC740 \uBE68\uAC15, \uC624\uB978\uCABD \uC704 \uC601\uC5ED\uC740
    \uB178\uB791, \uC67C\uCABD \uC544\uB798\uC640 \uC624\uB978\uCABD \uC544\uB798
    \uC601\uC5ED\uC740 \uD30C\uB791\uC785\uB2C8\uB2E4. \uBE68\uAC15\xB7\uB178\uB791\xB7\uD30C\uB791\uC758
    \uC0BC\uC6D0\uC0C9\uC744 \uC0AC\uC6A9\uD558\uBA70 \uD63C\uC0C9 \uACFC\uC815\uC740
    \uD310\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  features:
  - id: F1
    name: "\uC0AC\uAC01\uD615 \uC678\uACFD"
    criteria: "\uB124 \uBCC0\uC744 \uAC00\uC9C4 \uC9C1\uC0AC\uAC01\uD615\uC5D0 \uAC00\uAE4C\uC6B4
      \uC678\uACFD\uC774 \uC2DD\uBCC4\uB418\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uC120\uC774
      \uC090\uB6A4\uAC70\uB098 \uBAA8\uC11C\uB9AC\uAC00 \uB465\uAE00\uACE0 \uBE44\uC728\uC774
      \uB2EC\uB77C\uB3C4 \uC778\uC815\uD569\uB2C8\uB2E4. \uC6D0\uD615\uC774\uB098
      \uC0BC\uAC01\uD615\uCC98\uB7FC \uBA85\uD655\uD788 \uB2E4\uB978 \uC678\uACFD\uC774\uBA74
      \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    check: 3
    color: 0
    area: 0
    wrongSprite: {fileID: 21300000, guid: 7408299083bcf394c908951e59220f45, type: 3}
  - id: F2
    name: "\uB124 \uCE78\uC73C\uB85C \uB098\uB204\uB294 \uC2ED\uC790\uC120"
    criteria: "\uC678\uACFD \uB0B4\uBD80\uC5D0 \uAC00\uB85C \uAD6C\uBD84\uC120 \uD558\uB098\uC640
      \uC138\uB85C \uAD6C\uBD84\uC120 \uD558\uB098\uAC00 \uAD50\uCC28\uD558\uC5EC
      \uB124 \uC601\uC5ED\uC73C\uB85C \uB098\uB258\uC5B4\uC57C \uD569\uB2C8\uB2E4.
      \uC120\uC774 \uC911\uC559\uC774 \uC544\uB2C8\uAC70\uB098 \uC870\uAE08 \uD718\uC5B4\uB3C4
      \uC778\uC815\uD569\uB2C8\uB2E4. \uC0C9 \uACBD\uACC4\uB9CC \uC788\uACE0 \uAD6C\uBD84\uC120\uC774
      \uC5C6\uAC70\uB098, \uD55C \uBC29\uD5A5 \uC120\uB9CC \uC788\uC73C\uBA74 \uC778\uC815\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    check: 7
    color: 0
    area: 0
    wrongSprite: {fileID: 21300000, guid: 2fb62462e52e319429f4693fa1bf59e6, type: 3}
  - id: F3
    name: "\uC67C\uCABD \uC704 \uBE68\uAC15"
    criteria: "\uC67C\uCABD \uC704 \uC601\uC5ED\uC758 \uC8FC\uB41C \uCC44\uC0C9\uC774
      \uBE68\uAC04\uC0C9 \uACC4\uC5F4\uC774\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uAC70\uCE5C
      \uCC44\uC0C9\uACFC \uC57D\uAC04\uC758 \uBE48\uD2C8\uC740 \uC778\uC815\uD569\uB2C8\uB2E4.
      \uC791\uC740 \uC810\uC774\uB098 \uC120\uB9CC \uC788\uC73C\uBA74 \uC778\uC815\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    check: 8
    color: 1
    area: 0
    wrongSprite: {fileID: 21300000, guid: 961b983b15db1114ea77213520f43ec4, type: 3}
  - id: F4
    name: "\uC624\uB978\uCABD \uC704 \uB178\uB791"
    criteria: "\uC624\uB978\uCABD \uC704 \uC601\uC5ED\uC758 \uC8FC\uB41C \uCC44\uC0C9\uC774
      \uB178\uB780\uC0C9 \uACC4\uC5F4\uC774\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uAC70\uCE5C
      \uCC44\uC0C9\uACFC \uC57D\uAC04\uC758 \uBE48\uD2C8\uC740 \uC778\uC815\uD569\uB2C8\uB2E4.
      \uC791\uC740 \uC810\uC774\uB098 \uC120\uB9CC \uC788\uC73C\uBA74 \uC778\uC815\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    check: 8
    color: 2
    area: 1
    wrongSprite: {fileID: 21300000, guid: 02539ee023b693b47b12269f4e1fd590, type: 3}
  - id: F5
    name: "\uC544\uB798 \uB450 \uCE78 \uD30C\uB791"
    criteria: "\uC67C\uCABD \uC544\uB798\uC640 \uC624\uB978\uCABD \uC544\uB798 \uC601\uC5ED
      \uBAA8\uB450\uC758 \uC8FC\uB41C \uCC44\uC0C9\uC774 \uD30C\uB780\uC0C9 \uACC4\uC5F4\uC774\uC5B4\uC57C
      \uD569\uB2C8\uB2E4. \uD55C\uCABD\uB9CC \uD30C\uB791\uC774\uAC70\uB098 \uD30C\uB791\uC774
      \uC704\uCABD\uC5D0\uB9CC \uC788\uC73C\uBA74 \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    check: 8
    color: 3
    area: 2
    wrongSprite: {fileID: 21300000, guid: e0200081c3b317d40b2ae41753a97955, type: 3}
