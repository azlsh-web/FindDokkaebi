--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76559bebd3ca412438493db7848d8f3b, type: 3}
  m_Name: Stage5_Friend
  m_EditorClassIdentifier: Assembly-CSharp::StageData
  stageNumber: 5
  targetName: "\uCE5C\uAD6C"
  introStory: "\uC18C\uD48D \uC900\uBE44\uBB3C\uC744 \uB2E4 \uCC3E\uC558\uC5B4\uC694!\n\uADF8\uB7F0\uB370
    \uAC19\uC774 \uAC00\uAE30\uB85C \uD55C \uCE5C\uAD6C\uAC00 \uC548 \uBCF4\uC5EC\uC694.\n\uB3C4\uAE68\uBE44\uAC00
    \uCE5C\uAD6C\uB3C4 \uCC3E\uC544 \uC900\uB300\uC694.\n\uCE5C\uAD6C\uC758 \uBA38\uB9AC\uC640
    \uC637 \uC0C9\uC744 \uC798 \uBCF4\uC138\uC694."
  newRule: "\uB450 \uAC00\uC9C0 \uC774\uC0C1 \uC0C9\uC744 \uC790\uC720\uB86D\uAC8C
    \uC11E\uC5B4\uC694.\n\uC608) \uBE68\uAC15 + \uB178\uB791 + \uD30C\uB791 = \uAC08\uC0C9"
  learnedRules: "\uBAA8\uC591 \xB7 \uBB34\uB2AC \xB7 \uC0BC\uC6D0\uC0C9 \xB7 \uB450
    \uC0C9 \uD63C\uD569"
  colorMode: 3
  originalSprite: {fileID: 21300000, guid: cfd53b1f86548564799c0534cef16c02, type: 3}
  targetDescription: "\uC815\uBA74\uC5D0\uC11C \uBCF8 \uCE5C\uAD6C\uC785\uB2C8\uB2E4.
    \uC591 \uAC08\uB798\uB85C \uBB36\uC740 \uAC08\uC0C9 \uBA38\uB9AC, \uC0B4\uAD6C\uC0C9(\uC8FC\uD669
    \uACC4\uC5F4) \uBC18\uD314 \uC0C1\uC758, \uC55E\uC8FC\uBA38\uB2C8\uC5D0 \uCC9C
    \uC870\uAC01\uC744 \uB367\uB304 \uD30C\uB780 \uBA5C\uBE75 \uBC18\uBC14\uC9C0\uB97C
    \uC785\uACE0 \uB178\uB780 \uC2E0\uBC1C\uC744 \uC2E0\uC5C8\uC2B5\uB2C8\uB2E4.
    \uAC08\uC0C9\uC740 \uC138 \uC0C9 \uD63C\uD569, \uC8FC\uD669\uC740 \uB450 \uC0C9
    \uD63C\uD569\uC73C\uB85C \uB9CC\uB4DC\uB294 \uC0C9\uC785\uB2C8\uB2E4."
  features:
  - id: F1
    name: "\uC591 \uAC08\uB798 \uBA38\uB9AC"
    criteria: "\uBA38\uB9AC \uC591\uC606\uC73C\uB85C \uBB36\uC740 \uBA38\uB9AC \uB450
      \uAC08\uB798\uAC00 \uAD6C\uBD84\uB418\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uB2E8\uBC1C\uC774\uB098
      \uD55C \uAC08\uB798 \uBA38\uB9AC\uB294 \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    check: 22
    color: 0
    area: 0
  - id: F2
    name: "\uC8FC\uBA38\uB2C8 \uCC9C \uC870\uAC01"
    criteria: "\uD558\uC758 \uC55E\uCABD \uC8FC\uBA38\uB2C8 \uC790\uB9AC\uC5D0 \uB367\uB304
      \uC791\uC740 \uCC9C \uC870\uAC01\uC774 \uD45C\uD604\uB418\uC5B4 \uC788\uC5B4\uC57C
      \uD569\uB2C8\uB2E4. \uCC9C \uC870\uAC01\uC774 \uC5C6\uB294 \uC8FC\uBA38\uB2C8\uB294
      \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    check: 23
    color: 0
    area: 0
  - id: F3
    name: "\uD30C\uB780 \uBC14\uC9C0"
    criteria: "\uD558\uC758(\uBA5C\uBE75\uBC14\uC9C0)\uC758 \uC8FC\uB41C \uCC44\uC0C9\uC774
      \uD30C\uB780\uC0C9 \uACC4\uC5F4\uC774\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uBE68\uAC15\uC774\uB098
      \uBCF4\uB77C\uCC98\uB7FC \uBA85\uD655\uD788 \uB2E4\uB978 \uC0C9\uC774\uBA74
      \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    check: 17
    color: 3
    area: 8
  - id: F4
    name: "\uC8FC\uD669 \uC0C1\uC758"
    criteria: "\uC0C1\uC758(\uBAB8\uD1B5 \uC717\uBD80\uBD84)\uC5D0 \uC8FC\uD669\xB7\uC0B4\uAD6C\uC0C9
      \uACC4\uC5F4\uC774 \uCE60\uD574\uC838 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4.
      \uBE68\uAC15\uC774\uB098 \uCD08\uB85D\uCC98\uB7FC \uBA85\uD655\uD788 \uB2E4\uB978
      \uC0C9\uC774\uBA74 \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    check: 17
    color: 5
    area: 7
  - id: F5
    name: "\uAC08\uC0C9 \uBA38\uB9AC"
    criteria: "\uBA38\uB9AC\uCE74\uB77D \uBD80\uBD84\uC758 \uC8FC\uB41C \uCC44\uC0C9\uC774
      \uAC08\uC0C9 \uACC4\uC5F4\uC774\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uAC80\uC815,
      \uC8FC\uD669, \uB178\uB791\uCC98\uB7FC \uBA85\uD655\uD788 \uB2E4\uB978 \uC0C9\uC774\uBA74
      \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    check: 17
    color: 7
    area: 6
