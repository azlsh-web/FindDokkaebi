  m_Script: {fileID: 11500000, guid: 76559bebd3ca412438493db7848d8f3b, type: 3}
  m_Name: Stage1_Bat
  m_EditorClassIdentifier: Assembly-CSharp::StageData
  stageNumber: 1
  targetName: "\uBC29\uB9DD\uC774"
  introStory: "\uC18C\uD48D \uC900\uBE44\uBB3C\uC774 \uBAA8\uB450 \uC0AC\uB77C\uC84C\uC5B4\uC694!\n\uCABD\uC9C0\uC5D0
    \uADF8\uB9BC\uC744 \uADF8\uB824 \uAC04\uC2DD\uACFC \uD568\uAED8 \uB450\uBA74\n\uB3C4\uAE68\uBE44\uAC00
    \uBB3C\uAC74\uC744 \uCC3E\uC544\uC900\uB300\uC694.\n\uADF8\uB7F0\uB370 \uB3C4\uAE68\uBE44\uAC00
    \uBA3C\uC800 \uBD80\uD0C1\uD574\uC694.\n\"\uB0B4 \uBC29\uB9DD\uC774\uBD80\uD130
    \uCC3E\uC544 \uC918!\""
  newRule: "\uAC80\uC740 \uD39C\uC73C\uB85C \uBAA8\uC591(\uD615\uD0DC)\uC744 \uADF8\uB824\uC694.\n\uC9C0\uC6B0\uAC1C
    \xB7 \uC120 \uAD75\uAE30 \xB7 \uB418\uB3CC\uB9AC\uAE30 \xB7 \uBAA8\uB450 \uC9C0\uC6B0\uAE30\uB97C
    \uC4F8 \uC218 \uC788\uC5B4\uC694."
  learnedRules: 
  colorMode: 0
  originalSprite: {fileID: 21300000, guid: c105f48813aed8d4597fa47555f0be9d, type: 3}
  targetDescription: "\uAC00\uB298\uACE0 \uAE34 \uC190\uC7A1\uC774\uC640, \uC190\uC7A1\uC774\uBCF4\uB2E4
    \uAD75\uC740 \uBA38\uB9AC\uAC00 \uC5F0\uACB0\uB41C \uB3C4\uAE68\uBE44\uBC29\uB9DD\uC774\uC785\uB2C8\uB2E4.
    \uBA38\uB9AC \uBD80\uBD84\uC758 \uBC14\uAE65 \uC724\uACFD\uC5D0\uB294 \uBFB0\uC871\uD55C
    \uB3CC\uAE30\uAC00 \uB450 \uAC1C \uC774\uC0C1 \uC788\uC2B5\uB2C8\uB2E4. \uAC80\uC740\uC0C9\uC73C\uB85C
    \uD615\uD0DC\uB9CC \uD45C\uD604\uD558\uB294 \uB2E8\uACC4\uC774\uBA70, \uC0C9\uACFC
    \uD328\uD134\uC740 \uD310\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  features:
  - id: F1
    name: "\uAE38\uCB49\uD55C \uC190\uC7A1\uC774"
    criteria: "\uBC29\uB9DD\uC774\uC758 \uD55C\uCABD\uC5D0 \uAC00\uB298\uACE0 \uAE38\uAC8C
      \uBED7\uC740 \uC190\uC7A1\uC774\uAC00 \uD45C\uD604\uB418\uC5B4 \uC788\uC5B4\uC57C
      \uD569\uB2C8\uB2E4. \uAE38\uC774\uAC00 \uD3ED\uBCF4\uB2E4 \uAE34 \uD615\uD0DC\uB85C
      \uC2DD\uBCC4\uB418\uBA74 \uC778\uC815\uD569\uB2C8\uB2E4. \uC120\uC774 \uD718\uAC70\uB098
      \uD55C \uC904\uB85C \uADF8\uB838\uC5B4\uB3C4 \uAE38\uCB49\uD55C \uC5F0\uACB0
      \uBD80\uBD84\uC73C\uB85C \uC2DD\uBCC4\uB418\uBA74 \uC778\uC815\uD569\uB2C8\uB2E4."
    wrongSprite: {fileID: 21300000, guid: 165d725516ee7f240ab84de68feeb496, type: 3}
  - id: F2
    name: "\uC190\uC7A1\uC774\uBCF4\uB2E4 \uAD75\uC740 \uBA38\uB9AC"
    criteria: "\uC190\uC7A1\uC774 \uD55C\uCABD \uB05D\uC5D0 \uC190\uC7A1\uC774\uBCF4\uB2E4
      \uD3ED\uC774 \uB113\uC740 \uBA38\uB9AC \uBD80\uBD84\uC774 \uC788\uC5B4\uC57C
      \uD569\uB2C8\uB2E4. \uB465\uAE00\uAC70\uB098 \uAC01\uC838\uB3C4 \uC778\uC815\uD569\uB2C8\uB2E4.
      \uBA38\uB9AC\uC640 \uC190\uC7A1\uC774\uAC00 \uD558\uB098\uB85C \uC774\uC5B4\uC838\uC57C
      \uD558\uBA70, \uBA38\uB9AC\uB9CC \uB530\uB85C \uC788\uAC70\uB098 \uC190\uC7A1\uC774\uC640
      \uB5A8\uC5B4\uC838 \uC788\uC73C\uBA74 \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    wrongSprite: {fileID: 21300000, guid: 71f0de3f933d6b748bde90ef2ebd5027, type: 3}
  - id: F3
    name: "\uBA38\uB9AC \uBC14\uAE65\uC758 \uB3CC\uAE30 2\uAC1C \uC774\uC0C1"
    criteria: "\uBA38\uB9AC \uBD80\uBD84\uC758 \uBC14\uAE65 \uC724\uACFD\uC5D0\uC11C
      \uD280\uC5B4\uB098\uC628 \uBFB0\uC871\uD55C \uB3CC\uAE30\uAC00 \uB450 \uAC1C
      \uC774\uC0C1 \uAD6C\uBD84\uB418\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uC0BC\uAC01\uD615,
      \uBFD4 \uBAA8\uC591, \uC9E7\uACE0 \uBFB0\uC871\uD55C \uC120\uB3C4 \uC778\uC815\uD569\uB2C8\uB2E4.
      \uBA38\uB9AC \uC548\uCABD\uC758 \uBB34\uB2AC\uB098 \uC810, \uD55C \uAC1C\uBFD0\uC778
      \uB3CC\uAE30, \uC190\uC7A1\uC774\uC758 \uB3CC\uAE30\uB294 \uC778\uC815\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    wrongSprite: {fileID: 21300000, guid: 4276c26f4aebb5c4cafb5d0efce5f923, type: 3}
