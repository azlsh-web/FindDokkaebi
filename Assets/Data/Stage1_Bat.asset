  stageNumber: 1
  targetName: "\uBC29\uB9DD\uC774"
  introStory: "\uC18C\uD48D \uC900\uBE44\uBB3C\uC774 \uBAA8\uB450 \uC0AC\uB77C\uC84C\uC5B4\uC694!\n\uCABD\uC9C0\uC5D0
    \uADF8\uB9BC\uC744 \uADF8\uB824 \uAC04\uC2DD\uACFC \uD568\uAED8 \uB450\uBA74\n\uB3C4\uAE68\uBE44\uAC00
    \uBB3C\uAC74\uC744 \uCC3E\uC544\uC900\uB300\uC694.\n\uADF8\uB7F0\uB370 \uB3C4\uAE68\uBE44\uAC00
    \uBA3C\uC800 \uBD80\uD0C1\uD574\uC694.\n\"\uB0B4 \uBC29\uB9DD\uC774\uBD80\uD130
    \uCC3E\uC544 \uC918!\""
  newRule: "\uAC80\uC740 \uD39C\uC73C\uB85C \uBAA8\uC591(\uD615\uD0DC)\uC744 \uADF8\uB824\uC694.\n\uC9C0\uC6B0\uAC1C
    \xB7 \uC120 \uAD75\uAE30 \xB7 \uB418\uB3CC\uB9AC\uAE30 \xB7 \uBAA8\uB450 \uC9C0\uC6B0\uAE30\uB97C
    \uC4F8 \uC218 \uC788\uC5B4\uC694."
  learnedRules: 
  colorMode: 0
  originalSprite: {fileID: 21300000, guid: c105f48813aed8d4597fa47555f0be9d, type: 3}
  targetDescription: "\uAC00\uB298\uACE0 \uAE34 \uC190\uC7A1\uC774\uC640, \uC190\uC7A1\uC774\uBCF4\uB2E4
    \uAD75\uC740 \uBA38\uB9AC\uAC00 \uC774\uC5B4\uC9C4 \uB3C4\uAE68\uBE44\uBC29\uB9DD\uC774\uC785\uB2C8\uB2E4.
    \uBA38\uB9AC\uC5D0\uB294 \uC9E7\uAC8C \uD280\uC5B4\uB098\uC628 \uB3CC\uAE30\uAC00
    \uC5EC\uB7EC \uAC1C \uC788\uACE0, \uC190\uC7A1\uC774\uC5D0\uB294 \uB9AC\uBCF8\uC774
    \uBB36\uC5EC \uC788\uC2B5\uB2C8\uB2E4. \uAC80\uC740\uC0C9\uC73C\uB85C \uD615\uD0DC\uB9CC
    \uD45C\uD604\uD558\uB294 \uB2E8\uACC4\uC774\uBA70, \uC0C9\uC740 \uD310\uC815\uD558\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4."
  features:
  - id: F1
    name: "\uAE34 \uC190\uC7A1\uC774 + \uAD75\uC740 \uBA38\uB9AC + \uB3CC\uAE30"
    criteria: "\uAC00\uB298\uACE0 \uAE34 \uC190\uC7A1\uC774 \uD55C\uCABD \uB05D\uC5D0
      \uC190\uC7A1\uC774\uBCF4\uB2E4 \uAD75\uC740 \uBA38\uB9AC\uAC00 \uC774\uC5B4\uC838
      \uC788\uACE0, \uBA38\uB9AC \uBC14\uAE65 \uC724\uACFD\uC5D0 \uD280\uC5B4\uB098\uC628
      \uB3CC\uAE30\uAC00 \uB450 \uAC1C \uC774\uC0C1 \uAD6C\uBD84\uB418\uC5B4\uC57C
      \uD569\uB2C8\uB2E4. \uBFB0\uC871\uD55C \uB3CC\uAE30, \uB465\uADFC \uD639, \uAD6C\uB984
      \uBAA8\uC591\uC744 \uC778\uC815\uD569\uB2C8\uB2E4. \uB9E4\uB048\uD55C \uC6D0\uC774\uB098
      \uD0C0\uC6D0 \uBA38\uB9AC, \uBA38\uB9AC \uC548\uCABD\uC758 \uBB34\uB2AC, \uC190\uC7A1\uC774\uC758
      \uB9AC\uBCF8\uC740 \uB3CC\uAE30\uB85C \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
