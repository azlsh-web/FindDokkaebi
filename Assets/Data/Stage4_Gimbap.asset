  m_Script: {fileID: 11500000, guid: 76559bebd3ca412438493db7848d8f3b, type: 3}
  m_Name: Stage4_Gimbap
  m_EditorClassIdentifier: Assembly-CSharp::StageData
  stageNumber: 4
  targetName: "\uAE40\uBC25"
  introStory: "\uB9DB\uC788\uB294 \uAE40\uBC25\uB3C4 \uC0AC\uB77C\uC84C\uC5B4\uC694!\n\uAE40\uBC25
    \uC18D \uC7AC\uB8CC\uC758 \uC0C9\uC744 \uC798 \uBCF4\uC138\uC694.\n\uC5C6\uB294
    \uC0C9\uC740 \uD314\uB808\uD2B8\uC5D0\uC11C \uC11E\uC5B4\uC11C \uB9CC\uB4E4\uC5B4\uC694."
  newRule: "[\uC0C9 \uC11E\uAE30]\uB85C \uB450 \uAC00\uC9C0 \uC0C9\uC744 \uC11E\uC5B4
    \uC0C8 \uC0C9\uC744 \uB9CC\uB4E4\uC5B4\uC694.\n\uC608) \uB178\uB791 + \uD30C\uB791
    = \uCD08\uB85D"
  learnedRules: "\uBAA8\uC591 \xB7 \uBB34\uB2AC \xB7 \uBE68\uAC15 \uB178\uB791 \uD30C\uB791
    \uCE60\uD558\uAE30"
  colorMode: 2
  originalSprite: {fileID: 21300000, guid: 4c91f2732fda04f4e96be6f5e3bfbd60, type: 3}
  targetDescription: "\uB2E8\uBA74\uC5D0\uC11C \uBCF8 \uB3D9\uADF8\uB780 \uAE40\uBC25\uC785\uB2C8\uB2E4.
    \uAC00\uC7A5 \uBC14\uAE65\uC740 \uB450\uAEBC\uC6B4 \uAC80\uC740 \uAE40 \uD14C\uB450\uB9AC\uC774\uACE0,
    \uADF8 \uC548\uCABD \uB113\uC740 \uBD80\uBD84\uC740 \uD770 \uBC25\uC785\uB2C8\uB2E4.
    \uBC25 \uC548\uCABD \uC704\uC5D0 \uBE68\uAC04 \uC7AC\uB8CC\uC640 \uB178\uB780
    \uC7AC\uB8CC\uAC00 \uB098\uB780\uD788 \uC788\uACE0, \uADF8 \uC544\uB798\uC5D0
    \uCD08\uB85D \uC7AC\uB8CC\uAC00 \uC788\uC2B5\uB2C8\uB2E4. \uCD08\uB85D\uC740
    \uB178\uB791\uACFC \uD30C\uB791\uC744 \uC11E\uC5B4 \uB9CC\uB4E0 \uD63C\uD569\uC0C9\uC785\uB2C8\uB2E4."
  features:
  - id: F1
    name: "\uAC80\uC740 \uAE40 \uD14C\uB450\uB9AC"
    criteria: "\uAC00\uC7A5 \uBC14\uAE65\uC5D0 \uAC80\uC740\uC0C9 \uB465\uADFC \uD14C\uB450\uB9AC\uAC00
      \uB458\uB7EC\uC838 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uC120\uC774 \uAD75\uC9C0
      \uC54A\uC544\uB3C4 \uB465\uADFC \uAC80\uC740 \uC678\uACFD\uC774 \uC2DD\uBCC4\uB418\uBA74
      \uC778\uC815\uD569\uB2C8\uB2E4. \uB2E4\uB978 \uC0C9 \uD14C\uB450\uB9AC\uB098
      \uC0AC\uAC01\uD615 \uC678\uACFD\uC740 \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    wrongSprite: {fileID: 21300000, guid: e89ad7c5cdce71549aeb56a80a9a1744, type: 3}
  - id: F2
    name: "\uD770 \uBC25"
    criteria: "\uAC80\uC740 \uD14C\uB450\uB9AC \uC548\uCABD\uC758 \uB113\uC740 \uBD80\uBD84\uC774
      \uD770\uC0C9(\uCE60\uD558\uC9C0 \uC54A\uC740 \uD770 \uC885\uC774 \uD3EC\uD568)\uC73C\uB85C
      \uB0A8\uC544 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uBC25 \uBD80\uBD84 \uC804\uCCB4\uB97C
      \uB2E4\uB978 \uC0C9\uC73C\uB85C \uCE60\uD588\uC73C\uBA74 \uC778\uC815\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    wrongSprite: {fileID: 21300000, guid: 0468d081063562a4cb52057c6772033d, type: 3}
  - id: F3
    name: "\uBE68\uAC04 \uC7AC\uB8CC"
    criteria: "\uBC25 \uC548\uCABD\uC5D0 \uBE68\uAC04\uC0C9 \uACC4\uC5F4\uB85C \uCE60\uD55C
      \uC7AC\uB8CC \uC870\uAC01\uC774 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uD14C\uB450\uB9AC
      \uBC16\uC758 \uBE68\uAC15\uC740 \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    wrongSprite: {fileID: 21300000, guid: f1f3e0f75c5790a42a9f4daf5842d20c, type: 3}
  - id: F4
    name: "\uB178\uB780 \uC7AC\uB8CC"
    criteria: "\uBC25 \uC548\uCABD\uC5D0 \uB178\uB780\uC0C9 \uACC4\uC5F4\uB85C \uCE60\uD55C
      \uC7AC\uB8CC \uC870\uAC01\uC774 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uD14C\uB450\uB9AC
      \uBC16\uC758 \uB178\uB791\uC740 \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    wrongSprite: {fileID: 21300000, guid: 5009304457d98e444ad633588ccf0099, type: 3}
  - id: F5
    name: "\uCD08\uB85D \uC7AC\uB8CC"
    criteria: "\uBC25 \uC548\uCABD\uC5D0 \uCD08\uB85D\uC0C9 \uACC4\uC5F4\uB85C \uCE60\uD55C
      \uC7AC\uB8CC \uC870\uAC01\uC774 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uD30C\uB791\uC774\uB098
      \uB178\uB791\uB9CC \uC788\uC73C\uBA74 \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    wrongSprite: {fileID: 21300000, guid: 26e9ad078ac331045adbe5add000c4bc, type: 3}
