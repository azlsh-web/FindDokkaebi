  m_Script: {fileID: 11500000, guid: 76559bebd3ca412438493db7848d8f3b, type: 3}
  m_Name: Stage2_Bag
  m_EditorClassIdentifier: Assembly-CSharp::StageData
  stageNumber: 2
  targetName: "\uAC00\uBC29"
  introStory: "\uBC29\uB9DD\uC774\uB97C \uCC3E\uC740 \uB3C4\uAE68\uBE44\uAC00 \uC2E0\uC774
    \uB0AC\uC5B4\uC694.\n\"\uC774\uC81C \uB124 \uBB3C\uAC74\uC744 \uCC3E\uC544 \uC904\uAC8C!\"\n\uBA3C\uC800
    \uC18C\uD48D \uAC00\uBC29\uC744 \uCC3E\uC544\uC694.\n\uC8FC\uBA38\uB2C8 \uC548\uC758
    \uC904\uBB34\uB2AC\uB97C \uC798 \uBCF4\uC138\uC694."
  newRule: "\uBAA8\uC591 \uC548\uC5D0 \uBB34\uB2AC(\uD328\uD134)\uB97C \uB123\uC5B4\uC694.\n\uBB34\uB2AC\uC758
    \uBAA8\uC591\uACFC \uC704\uCE58\uB3C4 \uAE30\uC5B5\uD574\uC57C \uD574\uC694."
  learnedRules: "\uAC80\uC740 \uD39C\uC73C\uB85C \uBAA8\uC591 \uADF8\uB9AC\uAE30"
  colorMode: 0
  originalSprite: {fileID: 21300000, guid: 9e78685f6a91546438e02efdef4eee7d, type: 3}
  targetDescription: "\uC815\uBA74\uC5D0\uC11C \uBCF8 \uB124\uBAA8\uB09C \uAC00\uBC29\uC785\uB2C8\uB2E4.
    \uC704\uCABD\uC5D0 \uB465\uADFC \uC190\uC7A1\uC774\uAC00 \uD558\uB098 \uC788\uACE0,
    \uBAB8\uCCB4 \uC55E\uCABD \uC544\uB798\uC5D0 \uB124\uBAA8\uB09C \uC8FC\uBA38\uB2C8\uAC00
    \uC788\uC73C\uBA70, \uC8FC\uBA38\uB2C8 \uC548\uC5D0\uB294 \uAC00\uB85C \uC904\uBB34\uB2AC\uAC00
    \uC138 \uC904 \uC788\uC2B5\uB2C8\uB2E4. \uAC80\uC740\uC0C9\uC73C\uB85C \uD615\uD0DC\uC640
    \uBB34\uB2AC\uB9CC \uD45C\uD604\uD558\uB294 \uB2E8\uACC4\uC774\uBA70, \uC0C9\uC740
    \uD310\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  features:
  - id: F1
    name: "\uB124\uBAA8\uB09C \uAC00\uBC29 \uBAB8\uCCB4"
    criteria: "\uB124 \uBCC0\uC744 \uAC00\uC9C4 \uC0AC\uAC01\uD615\uC5D0 \uAC00\uAE4C\uC6B4
      \uAC00\uBC29 \uBAB8\uCCB4 \uC678\uACFD\uC774 \uC2DD\uBCC4\uB418\uC5B4\uC57C
      \uD569\uB2C8\uB2E4. \uBAA8\uC11C\uB9AC\uAC00 \uB465\uAE00\uAC70\uB098 \uC120\uC774
      \uC090\uB6A4\uC5B4\uB3C4 \uC778\uC815\uD569\uB2C8\uB2E4. \uC6D0\uD615\uC774\uB098
      \uC0BC\uAC01\uD615\uCC98\uB7FC \uBA85\uD655\uD788 \uB2E4\uB978 \uC678\uACFD\uC774\uBA74
      \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    check: 3
    color: 0
    area: 0
    wrongSprite: {fileID: 21300000, guid: 6013900ebb409eb459cfc9708431ca34, type: 3}
  - id: F2
    name: "\uC704\uCABD \uC190\uC7A1\uC774"
    criteria: "\uBAB8\uCCB4 \uC704\uCABD\uC5D0 \uACE0\uB9AC\uB098 \uC544\uCE58 \uBAA8\uC591\uC758
      \uC190\uC7A1\uC774\uAC00 \uBAB8\uCCB4\uC640 \uC774\uC5B4\uC838 \uC788\uC5B4\uC57C
      \uD569\uB2C8\uB2E4. \uC190\uC7A1\uC774\uAC00 \uBAB8\uCCB4 \uC606\uC774\uB098
      \uC544\uB798\uC5D0\uB9CC \uC788\uC73C\uBA74 \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    check: 4
    color: 0
    area: 0
    wrongSprite: {fileID: 21300000, guid: 6b3511fbb76a3d04795f14df1e85bee0, type: 3}
  - id: F3
    name: "\uC55E\uCABD \uC8FC\uBA38\uB2C8"
    criteria: "\uBAB8\uCCB4 \uC548\uCABD\uC5D0 \uBAB8\uCCB4\uBCF4\uB2E4 \uC791\uC740
      \uC0AC\uAC01\uD615 \uC8FC\uBA38\uB2C8 \uC678\uACFD\uC774 \uB530\uB85C \uADF8\uB824\uC838
      \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uBAB8\uCCB4 \uC678\uACFD\uB9CC \uC788\uACE0
      \uC8FC\uBA38\uB2C8 \uAD6C\uBD84\uC120\uC774 \uC5C6\uC73C\uBA74 \uC778\uC815\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    check: 5
    color: 0
    area: 0
    wrongSprite: {fileID: 21300000, guid: b525a8133cacdf5478601eb10b7169da, type: 3}
  - id: F4
    name: "\uC8FC\uBA38\uB2C8 \uC548 \uAC00\uB85C \uC904\uBB34\uB2AC"
    criteria: "\uC8FC\uBA38\uB2C8 \uC678\uACFD \uC548\uC5D0 \uAC00\uB85C \uBC29\uD5A5
      \uC904\uC774 \uB450 \uC904 \uC774\uC0C1 \uBC18\uBCF5\uB418\uC5B4\uC57C \uD569\uB2C8\uB2E4.
      \uC138\uB85C\uC904\uC774\uB098 \uC810, \uC8FC\uBA38\uB2C8 \uBC16\uC5D0\uB9CC
      \uC788\uB294 \uC904\uC740 \uC778\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    check: 6
    color: 0
    area: 0
    wrongSprite: {fileID: 21300000, guid: 12a6b652c8d5d6f4aa3f25fca2463698, type: 3}
